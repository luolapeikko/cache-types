{
  "name": "@luolapeikko/cache-types",
  "version": "0.0.10",
  "description": "Typescript cache interfaces",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "docs": "typedoc",
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "lint": "biome check",
    "validate": "tsc --noEmit --project tsconfig.test.json"
  },
  "files": [
    "dist"
  ],
  "repository": "github:luolapeikko/cache-types",
  "keywords": [
    "cache",
    "typescript"
  ],
  "author": "mharj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/luolapeikko/cache-types/issues"
  },
  "homepage": "https://github.com/luolapeikko/cache-types#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.3.2",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
